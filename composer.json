{
    "name": "davidyusaku/pawshop",
    "description": "Modern containerized PHP e-commerce platform for pet care supplies.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "David Yusaku Setiyono",
            "email": "davidyusaku13@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4 || ^8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox"
    }
}
